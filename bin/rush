#!/usr/bin/env php
<?php declare(strict_types=1);

use Rush\Manager\Application;
use Rush\Manager\Registry;

$projectRoot = getenv('RUSH_APP_ROOT');

if ($projectRoot === false || $projectRoot === '') {
    $projectRoot = getenv('RUSH_ROOT');
}

if ($projectRoot === false || $projectRoot === '') {
    $projectRoot = getcwd() ?: dirname(__DIR__);
}

$autoload = $GLOBALS['_composer_autoload_path'] ?? null;

if ( ! is_string($autoload) || ! is_file($autoload)) {
    $candidates = [
        $projectRoot .'/vendor/autoload.php',
        __DIR__ .'/../../../autoload.php',
        __DIR__ .'/../vendor/autoload.php',
    ];

    foreach ($candidates as $candidate) {
        if (is_file($candidate)) {
            $autoload = $candidate;
            break;
        }
    }
}

if ( ! is_string($autoload) || ! is_file($autoload)) {
    fwrite(STDERR, 'error: composer autoload not found'. PHP_EOL);
    exit(1);
}

require $autoload;

try {
    $application = new Application($projectRoot);

    foreach ((new Registry($projectRoot))->discover() as $tool) {
        $application->attach($tool);
    }

    $argv = $_SERVER['argv'] ?? [];
    $tokens = [];

    foreach (is_array($argv) ? $argv : [] as $token) {
        if (is_scalar($token)) {
            $tokens[] = (string) $token;
        }
    }

    exit($application->run(array_slice($tokens, 1)));
} catch (Throwable $exception) {
    fwrite(STDERR, 'error: '. $exception->getMessage() . PHP_EOL);
    exit(1);
}
